# Copy this file to .env and fill in what you use.
# The agent works with any OpenAI-compatible endpoint.

# --- LLM (required for chat; tools/memory work without it) ---
# Option A: OpenAI (or any compatible provider)
OPENAI_API_KEY=
# Option B: local model, e.g. Ollama -> http://localhost:11434/v1
OPENAI_BASE_URL=
# Model name, e.g. gpt-4o-mini, llama3.1, qwen2.5
MODEL_NAME=gpt-4o-mini

# --- Email tool (optional; send_email is approval-gated) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Storage (optional; defaults to ./data inside the repo) ---
AGENT_DATA_DIR=
